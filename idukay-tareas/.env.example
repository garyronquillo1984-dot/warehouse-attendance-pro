# Copia este archivo como .env SOLO en tu computadora para desarrollo/diagnóstico.
# En producción define estas variables en el panel de "Variables/Secrets" del hosting.
# Nunca subas el archivo .env al repositorio (ya está en .gitignore).

# --- Idukay (obligatorias) ---
IDUKAY_USERNAME=
IDUKAY_PASSWORD=

# --- Acceso a la app (obligatoria en producción) ---
APP_PASSWORD=
# Recomendado: cadena aleatoria larga (openssl rand -hex 32)
SESSION_SECRET=
# Cifra en disco la sesión guardada de Idukay (openssl rand -hex 32)
SESSION_ENCRYPTION_KEY=

# --- Programación ---
# internal = el servidor sincroniza solo cada hora; external = usa POST /api/cron/sync
SCHEDULER=internal
SYNC_CRON=0 * * * *
TZ_APP=America/Guayaquil
# Necesario si SCHEDULER=external (openssl rand -hex 32)
CRON_SECRET=

# --- Opcionales ---
STUDENTS=Gael,Edric
IDUKAY_LOGIN_URL=https://idukay.net/colegios/#/login
# Ruta de la sección de tareas, si la conoces (ej. #/tareas) — acelera y estabiliza la navegación
IDUKAY_TASKS_PATH=
# Selectores CSS manuales si la detección automática falla, en JSON:
# {"username":"#usuario","password":"#clave","submit":"button.login","tasksLink":"a[href*=tareas]","studentSwitch":".hijos","taskItem":".tarea-card"}
IDUKAY_SELECTORS=
HISTORY_DAYS=14
DATA_DIR=./data
PORT=3000
