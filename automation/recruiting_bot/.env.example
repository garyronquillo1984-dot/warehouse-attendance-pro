# Copy this file to .env and fill in the values. NEVER commit .env or paste keys in chat.

# --- Claude (interprets candidate replies in English/Spanish) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number candidates text (E.164, e.g. +18595551234)
TWILIO_FROM_NUMBER=
# Public URL of your deployed app, used to verify Twilio's signature (no trailing slash)
PUBLIC_BASE_URL=https://your-app.onrender.com
# Where Gary gets "new qualified candidate" alerts
GARY_NOTIFY_PHONE=+16147323986

# --- What qualified candidates receive ---
# Optional public application link (e.g. a SignNow group signing link). Leave empty and
# the bot tells them Gary will email the application.
APPLY_LINK=

# --- Database: sqlite (local / single server) or supabase ---
DB_BACKEND=sqlite
SQLITE_PATH=data/leads.db
SUPABASE_URL=
# Service-role key: server-side only, never in a browser or the artifact page
SUPABASE_SERVICE_KEY=

# --- Follow-ups (cron) ---
TIMEZONE=America/New_York
FOLLOWUP_AFTER_HOURS=6
MAX_NUDGES=2
# Messages only go out between these local hours (TCPA quiet hours)
SEND_WINDOW_START=9
SEND_WINDOW_END=20

# --- Email outreach CSV (sourcing) ---
AGENCY_NAME=Top Tier HR
# Required by CAN-SPAM in every outreach email: the agency's real postal address
AGENCY_MAILING_ADDRESS=

# Set to 1 to print SMS instead of sending (testing)
DRY_RUN=0
